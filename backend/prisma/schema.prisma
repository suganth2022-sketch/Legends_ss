generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------
// Enums
// -------------------------------------------------------------
enum MemberStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum PlanStatus {
  ACTIVE
  SUPERSEDED
}

enum PaymentStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentMode {
  ONLINE_RAZORPAY
  MANUAL_ADMIN
}

enum CommissionStatus {
  CREDITED
  REVERSED
}

enum PayoutStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  REJECTED
}

enum PayoutMode {
  UPI
  BANK_TRANSFER
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
}

enum ActorType {
  MEMBER
  ADMIN
  SYSTEM
}

// -------------------------------------------------------------
// 1. Members Table (Self-referencing sponsor hierarchy)
// -------------------------------------------------------------
model Member {
  id                String       @id @default(uuid())
  memberCode        String       @unique @map("member_code") // e.g. A000001
  fullName          String       @map("full_name")
  email             String       @unique
  phone             String       @unique
  passwordHash      String       @map("password_hash")
  sponsorId         String?      @map("sponsor_id")
  status            MemberStatus @default(ACTIVE)
  doj               DateTime     @default(now())
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  // Relations
  sponsor           Member?               @relation("SponsorTree", fields: [sponsorId], references: [id])
  downline          Member[]              @relation("SponsorTree")
  profile           MemberProfile?
  kyc               MemberKyc?
  bankDetails       MemberBankDetails?
  nominee           Nominee?
  paymentPlans      PaymentPlan[]
  payments          Payment[]
  commissionEarned  CommissionLedger[]    @relation("BeneficiaryCommissions")
  commissionSources CommissionLedger[]    @relation("SourceCommissions")
  payouts           Payout[]
  notifications     Notification[]

  @@index([sponsorId])
  @@index([memberCode])
  @@map("members")
}

// -------------------------------------------------------------
// 2. Member Profile (1:1 with Member)
// -------------------------------------------------------------
model MemberProfile {
  id          String   @id @default(uuid())
  memberId    String   @unique @map("member_id")
  dob         DateTime?
  address     String?
  city        String?
  state       String?
  pincode     String?
  photoUrl    String?  @map("photo_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_profiles")
}

// -------------------------------------------------------------
// 3. Member KYC (1:1 with Member - Encrypted AES-256)
// -------------------------------------------------------------
model MemberKyc {
  id               String    @id @default(uuid())
  memberId         String    @unique @map("member_id")
  aadhaarEncrypted String?   @map("aadhaar_encrypted")
  panEncrypted     String?   @map("pan_encrypted")
  status           KycStatus @default(NOT_SUBMITTED)
  verifiedAt       DateTime? @map("verified_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  member           Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_kyc")
}

// -------------------------------------------------------------
// 4. Member Bank Details (1:1 with Member - Encrypted Account)
// -------------------------------------------------------------
model MemberBankDetails {
  id                     String   @id @default(uuid())
  memberId               String   @unique @map("member_id")
  bankName               String   @map("bank_name")
  accountNumberEncrypted String   @map("account_number_encrypted")
  ifscCode               String   @map("ifsc_code")
  upiId                  String?  @map("upi_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  member                 Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("member_bank_details")
}

// -------------------------------------------------------------
// 5. Nominees Table
// -------------------------------------------------------------
model Nominee {
  id           String   @id @default(uuid())
  memberId     String   @unique @map("member_id")
  fullName     String   @map("full_name")
  relationship String
  phone        String?
  createdAt    DateTime @default(now()) @map("created_at")

  member       Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@map("nominees")
}

// -------------------------------------------------------------
// 6. Payment Plans (Committed Monthly Amount History)
// -------------------------------------------------------------
model PaymentPlan {
  id              String     @id @default(uuid())
  memberId        String     @map("member_id")
  committedAmount Decimal    @map("committed_amount") @db.Decimal(12, 2)
  effectiveFrom   DateTime   @default(now()) @map("effective_from")
  status          PlanStatus @default(ACTIVE)
  createdAt       DateTime   @default(now()) @map("created_at")

  member          Member     @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("payment_plans")
}

// -------------------------------------------------------------
// 7. Payments Table
// -------------------------------------------------------------
model Payment {
  id            String        @id @default(uuid())
  memberId      String        @map("member_id")
  amount        Decimal       @db.Decimal(12, 2)
  status        PaymentStatus @default(INITIATED)
  mode          PaymentMode   @default(ONLINE_RAZORPAY)
  transactionId String        @unique @map("transaction_id")
  paidAt        DateTime?     @map("paid_at")
  createdAt     DateTime      @default(now()) @map("created_at")

  member        Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  gatewayTx     PaymentGatewayTransaction?
  commissions   CommissionLedger[]

  @@index([memberId])
  @@index([transactionId])
  @@map("payments")
}

// -------------------------------------------------------------
// 8. Payment Gateway Transactions (Raw Webhook/Gateway Payloads)
// -------------------------------------------------------------
model PaymentGatewayTransaction {
  id            String   @id @default(uuid())
  paymentId     String   @unique @map("payment_id")
  gatewayStatus String   @map("gateway_status")
  rawPayload    Json     @map("raw_payload")
  createdAt     DateTime @default(now()) @map("created_at")

  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_gateway_transactions")
}

// -------------------------------------------------------------
// 9. Commission Rules (Versioned Rates for Levels 2–10)
// -------------------------------------------------------------
model CommissionRule {
  id            String    @id @default(uuid())
  level         Int       // 2 through 10 (Level 1 = the paying member/self, never stored — see docs/business-rules.md)
  percentage    Decimal   @db.Decimal(5, 2) // e.g. 10.00 for 10%
  effectiveFrom DateTime  @default(now()) @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([level])
  @@map("commission_rules")
}

// -------------------------------------------------------------
// 10. Commission Ledger (Immutable Ledger Rows per Beneficiary)
// -------------------------------------------------------------
model CommissionLedger {
  id             String           @id @default(uuid())
  paymentId      String           @map("payment_id")
  beneficiaryId  String           @map("beneficiary_id")
  sourceMemberId String           @map("source_member_id")
  level          Int              // 2 through 10; distance from payer, where payer=1 (self, excluded) and direct sponsor=2
  appliedRate    Decimal          @map("applied_rate") @db.Decimal(5, 2)
  baseAmount     Decimal          @map("base_amount") @db.Decimal(12, 2)
  earnedAmount   Decimal          @map("earned_amount") @db.Decimal(12, 2)
  status         CommissionStatus @default(CREDITED)
  createdAt      DateTime         @default(now()) @map("created_at")

  payment        Payment          @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  beneficiary    Member           @relation("BeneficiaryCommissions", fields: [beneficiaryId], references: [id], onDelete: Cascade)
  sourceMember   Member           @relation("SourceCommissions", fields: [sourceMemberId], references: [id], onDelete: Cascade)

  @@index([beneficiaryId])
  @@index([sourceMemberId])
  @@index([paymentId])
  @@map("commission_ledger")
}

// -------------------------------------------------------------
// 11. Payouts Table (Request -> Approval Workflow)
// -------------------------------------------------------------
model Payout {
  id                   String       @id @default(uuid())
  memberId             String       @map("member_id")
  referenceNo          String       @unique @map("reference_no")
  amount               Decimal      @db.Decimal(12, 2)
  paymentMode          PayoutMode   @default(UPI) @map("payment_mode")
  accountDetailsMasked String       @map("account_details_masked")
  status               PayoutStatus @default(PENDING)
  processedAt          DateTime?    @map("processed_at")
  adminNote            String?      @map("admin_note")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  member               Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([referenceNo])
  @@map("payouts")
}

// -------------------------------------------------------------
// 12. Notifications Table
// -------------------------------------------------------------
model Notification {
  id        String              @id @default(uuid())
  memberId  String              @map("member_id")
  title     String
  message   String
  channel   NotificationChannel @default(IN_APP)
  status    NotificationStatus  @default(QUEUED)
  createdAt DateTime            @default(now()) @map("created_at")

  member    Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@map("notifications")
}

// -------------------------------------------------------------
// 13. Announcements Table (Admin Broadcasts)
// -------------------------------------------------------------
model Announcement {
  id          String   @id @default(uuid())
  title       String
  content     String
  publishDate DateTime @default(now()) @map("publish_date")
  expiryDate  DateTime? @map("expiry_date")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("announcements")
}

// -------------------------------------------------------------
// 14. Admin Users Table (Staff Accounts)
// -------------------------------------------------------------
model AdminUser {
  id           String   @id @default(uuid())
  username     String   @unique
  email        String   @unique
  fullName     String   @map("full_name")
  passwordHash String   @map("password_hash")
  roleId       String   @map("role_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  role         Role     @relation(fields: [roleId], references: [id])

  @@map("admin_users")
}

// -------------------------------------------------------------
// 15. RBAC Tables (Roles, Permissions, RolePermissions)
// -------------------------------------------------------------
model Role {
  id          String           @id @default(uuid())
  name        String           @unique // e.g. Super Admin, Admin, Finance, Support
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")

  adminUsers  AdminUser[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique // e.g. members:read, payouts:approve
  name        String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at")

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// -------------------------------------------------------------
// 16. Audit Logs Table (Append-Only Sensitive Operation Tracking)
// -------------------------------------------------------------
model AuditLog {
  id             String    @id @default(uuid())
  actorType      ActorType @map("actor_type")
  actorId        String    @map("actor_id")
  action         String    // e.g. KYC_UNMASK, PAYOUT_APPROVE, RULE_CHANGE
  entityName     String    @map("entity_name")
  entityId       String    @map("entity_id")
  beforeSnapshot Json?     @map("before_snapshot")
  afterSnapshot  Json?     @map("after_snapshot")
  ipAddress      String?   @map("ip_address")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

// -------------------------------------------------------------
// 17. System Counters (Atomic sequence generator, e.g. member_code)
// -------------------------------------------------------------
model SystemCounter {
  key   String @id
  value Int    @default(0)

  @@map("system_counters")
}
